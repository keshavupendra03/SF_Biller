<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gst_Type__c</fullName>
    <description>Default GST treatment for this part — CGST+SGST (intra-state) or IGST (inter-state). Copied onto Bill_Line_Item__c/Estimate_Line_Item__c when a line is added, and overridable per line at that point (architecture.md §C.3).</description>
    <label>GST Type</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>CGST_SGST</fullName>
                <default>true</default>
                <label>CGST + SGST</label>
            </value>
            <value>
                <fullName>IGST</fullName>
                <default>false</default>
                <label>IGST</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
