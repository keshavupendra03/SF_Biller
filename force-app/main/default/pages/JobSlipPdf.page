<apex:page controller="JobSlipPdfController" renderAs="{!renderAs}" showHeader="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false">
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<style type="text/css">
    @page { size: A4; margin: 14px 16px; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 9px; color: #111; margin: 0; }
    table { border-collapse: collapse; width: 100%; }
    td, th { vertical-align: top; }
    .frame { border: 1.5px solid #111; }
    .frame-table { width: 100%; }
    .ws-name { text-align: center; font-size: 17px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; padding-top: 6px; }
    .ws-meta { text-align: center; font-size: 9px; padding: 2px 0 4px 0; }
    .title-band { background-color: #111; color: #fff; text-align: center; font-size: 12px; font-weight: bold; letter-spacing: 3px; padding: 3px 0; }
    .meta-row td { padding: 4px 6px; font-size: 10px; border-bottom: 1px solid #111; }
    .label { font-weight: bold; white-space: nowrap; }
    .value { font-size: 10px; }
    .grid td { border: 1px solid #555; padding: 3px 4px; height: 22px; }
    .grid td.label { width: 21%; background-color: #f2f2f2; font-size: 8.5px; }
    .addr { height: 34px; }
    .section-title { font-weight: bold; font-size: 8.5px; text-transform: uppercase; background-color: #f2f2f2; border: 1px solid #555; padding: 3px 4px; }
    .repairs { table-layout: fixed; }
    .repairs th { border: 1px solid #555; background-color: #f2f2f2; font-size: 8px; padding: 3px 2px; text-align: center; }
    .repairs td { border: 1px solid #555; height: 31px; padding: 2px 3px; font-size: 8.5px; word-wrap: break-word; }
    .repairs td.n { text-align: center; }
    .repairs td.amt { text-align: right; }
    .repairs tr.total td { font-weight: bold; background-color: #f2f2f2; }
    .side td { border: 1px solid #555; padding: 2px 4px; height: 21px; font-size: 8.5px; }
    .side td.k { width: 55%; background-color: #f2f2f2; font-weight: bold; }
    .fuel td { border: 1px solid #555; text-align: center; font-size: 10px; font-weight: bold; padding: 3px 0; }
    .fuel td.on { background-color: #111; color: #fff; }
    .tyres td { border: 1px solid #555; padding: 2px 4px; height: 21px; font-size: 8.5px; width: 50%; }
    .car { text-align: center; padding: 4px 0 2px 0; }
    .car-caption { text-align: center; font-size: 7.5px; color: #444; }
    .terms { font-size: 7.5px; line-height: 1.3; padding: 4px 6px; }
    .terms ol { margin: 2px 0 0 0; padding-left: 14px; }
    .terms li { margin-bottom: 1px; }
    .authorise { font-size: 8px; padding: 4px 6px; border-top: 1px solid #555; }
    .foot td { border: 1px solid #555; padding: 4px 6px; font-size: 9px; }
    .sign { height: 56px; vertical-align: bottom !important; text-align: center; font-weight: bold; font-size: 8.5px; }
    .pad-l { padding-right: 4px; }
</style>
</head>
<body>

<apex:outputPanel rendered="{!!recordFound}">
    <p>Record not found — pass a Job Slip, Vehicle or Customer record Id as the ?id= parameter.</p>
</apex:outputPanel>

<apex:outputPanel rendered="{!recordFound}">
<div class="frame">
<table class="frame-table">
    <!-- Header -->
    <tr><td class="ws-name">{!workshopName}</td></tr>
    <tr><td class="ws-meta">
        <apex:outputText value="{!workshopAddress}" rendered="{!NOT(ISBLANK(workshopAddress))}"/>
        <apex:outputText value="  |  Mob.: {0}" rendered="{!NOT(ISBLANK(workshopPhone))}"><apex:param value="{!workshopPhone}"/></apex:outputText>
        <apex:outputText value="  |  {0}" rendered="{!NOT(ISBLANK(workshopEmail))}"><apex:param value="{!workshopEmail}"/></apex:outputText>
    </td></tr>
    <tr><td class="title-band">JOB SLIP</td></tr>
    <tr><td style="padding: 0;">
        <table class="meta-row">
            <tr>
                <td style="width: 34%;"><span class="label">Date:</span> <span class="value">{!slipDate}</span></td>
                <td style="width: 33%; text-align: center;"><span class="label">Time In:</span> <span class="value">{!timeIn}</span></td>
                <td style="width: 33%; text-align: right;"><span class="label">Sr. No.:</span> <span class="value">{!slipNumber}</span></td>
            </tr>
        </table>
    </td></tr>

    <!-- Body: details + repairs (left), vehicle check-in (right) -->
    <tr><td style="padding: 5px;">
        <table>
            <tr>
                <td style="width: 67%;" class="pad-l">
                    <table class="grid">
                        <tr>
                            <td class="label">Customer Name &amp; Address</td>
                            <td colspan="3" class="addr"><strong>{!customerName}</strong><br/><apex:outputText value="{!customerAddress}"/></td>
                        </tr>
                        <tr>
                            <td class="label">Ph. No.</td><td style="width: 29%;">{!customerPhone}</td>
                            <td class="label">E-mail</td><td>{!customerEmail}</td>
                        </tr>
                        <tr>
                            <td class="label">Veh. Regn. No.</td><td><strong>{!registrationNumber}</strong></td>
                            <td class="label">Date of Sale</td><td>{!dateOfSale}</td>
                        </tr>
                        <tr>
                            <td class="label">Chassis No.</td><td>{!chassisNumber}</td>
                            <td class="label">Model</td><td>{!makeModel}</td>
                        </tr>
                        <tr>
                            <td class="label">Engine No.</td><td>{!engineNumber}</td>
                            <td class="label">Current Kms.</td><td>{!currentKm}</td>
                        </tr>
                        <tr>
                            <td class="label">Visit Due To</td><td colspan="3">{!visitReason}</td>
                        </tr>
                    </table>

                    <table class="repairs" style="margin-top: 5px;">
                        <colgroup>
                            <col style="width: 6%;"/>
                            <col style="width: 38%;"/>
                            <col style="width: 36%;"/>
                            <col style="width: 10%;"/>
                            <col style="width: 10%;"/>
                        </colgroup>
                        <tr>
                            <th rowspan="2">S.No.</th>
                            <th rowspan="2">Customer Verbatim / Demanded Repairs</th>
                            <th rowspan="2">Established Repairs / Observations</th>
                            <th colspan="2">Estimated Amount (Rs.)</th>
                        </tr>
                        <tr><th>Labour</th><th>Spares</th></tr>
                        <apex:repeat value="{!lines}" var="line">
                            <tr>
                                <td class="n">{!line.rowNumber}</td>
                                <td>{!line.customerRequest}</td>
                                <td>{!line.observation}</td>
                                <td class="amt">{!line.labour}</td>
                                <td class="amt">{!line.spares}</td>
                            </tr>
                        </apex:repeat>
                        <tr class="total">
                            <td colspan="3" style="text-align: right;">Total</td>
                            <td class="amt">{!labourTotal}</td>
                            <td class="amt">{!sparesTotal}</td>
                        </tr>
                    </table>
                </td>

                <td style="width: 33%;">
                    <div class="section-title" style="border-bottom: none;">Fuel</div>
                    <table class="fuel">
                        <tr>
                            <apex:repeat value="{!fuelLevels}" var="lvl">
                                <td class="{!IF(lvl.selected, 'on', '')}">{!lvl.label}</td>
                            </apex:repeat>
                        </tr>
                    </table>

                    <table class="side" style="margin-top: 5px;">
                        <apex:repeat value="{!accessories}" var="acc">
                            <tr><td class="k">{!acc.label}</td><td>{!acc.value}</td></tr>
                        </apex:repeat>
                        <tr><td class="k">Dent / Scratches</td><td>{!dentsScratches}</td></tr>
                        <tr><td class="k">Battery Make</td><td>{!batteryMake}</td></tr>
                        <tr><td class="k">Battery No.</td><td>{!batteryNumber}</td></tr>
                        <tr><td class="k">Tyre Make</td><td>{!tyreMake}</td></tr>
                    </table>

                    <table class="tyres" style="margin-top: 5px;">
                        <tr><td><strong>FR</strong> {!tyreFrontRight}</td><td><strong>FL</strong> {!tyreFrontLeft}</td></tr>
                        <tr><td><strong>RR</strong> {!tyreRearRight}</td><td><strong>RL</strong> {!tyreRearLeft}</td></tr>
                    </table>

                    <div class="car">
                        <div class="car-caption">FRONT</div>
                        <img src="{!$Resource.JobSlipCarDiagram}" style="width: 116px; height: 213px;" alt="Vehicle diagram"/>
                        <div class="car-caption">Mark dents / scratches on the diagram</div>
                    </div>
                </td>
            </tr>
        </table>
    </td></tr>

    <!-- Terms, delivery and signatures -->
    <tr><td style="padding: 0 5px 5px 5px;">
        <table>
            <tr>
                <td style="width: 58%; border: 1px solid #555;">
                    <div class="terms">
                        <strong>TERMS &amp; CONDITIONS</strong>
                        <ol>
                            <apex:repeat value="{!terms}" var="term">
                                <li>{!term}</li>
                            </apex:repeat>
                        </ol>
                    </div>
                    <div class="authorise">
                        I hereby authorise the above repairs to be carried out with the necessary materials, and the workshop staff to drive the vehicle for testing at my risk. I have read and agree to the terms and conditions above.
                    </div>
                </td>
                <td style="width: 42%; padding-left: 5px;">
                    <table class="foot">
                        <tr><td><span class="label">Service Advisor:</span> {!serviceAdvisorName}</td></tr>
                        <tr><td><span class="label">Mobile No.:</span> {!serviceAdvisorMobile}</td></tr>
                        <tr><td style="height: 22px;"><span class="label">Promised Delivery Date &amp; Time:</span><br/>{!promisedDelivery}</td></tr>
                        <tr><td style="height: 22px;"><span class="label">Total Cost Estimate:</span><br/>{!totalCostEstimate}</td></tr>
                    </table>
                </td>
            </tr>
        </table>
        <table class="foot" style="margin-top: 5px;">
            <tr>
                <td class="sign" style="width: 50%;">Signature of Service Advisor</td>
                <td class="sign" style="width: 50%;">Signature of Customer</td>
            </tr>
        </table>
    </td></tr>
</table>
</div>
</apex:outputPanel>

</body>
</html>
</apex:page>
